PORT=5000
NODE_ENV=development
SESSION_SECRET=ganti-dengan-secret-acak
CORS_ORIGIN=http://localhost:5173

# Database utama SuperApp (READ-ONLY: users, mst_employee, mst_position, mst_department) — untuk login SSO
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Database Alfi (development: alfi, production: alfi_prod) — tabel dibuat manual dari repo privat alfi-database (schema.sql)
DB_HOST_ALFI=
DB_PORT_ALFI=3306
DB_USER_ALFI=
DB_PASS_ALFI=
DB_NAME_ALFI=alfi

# Pembatasan menu Pembelian hanya untuk tim Finance. Sementara mati; isi true untuk menyalakan.
# PURCHASING_REQUIRE_FINANCE=false

# (Opsional, frontend) URL folder assets SuperApp agar lampiran pengajuan bisa dibuka:
# VITE_SUPERAPP_ASSET_URL=http://localhost:5001/assets

# Database POS my-waschen (READ-ONLY: tr_transaction, tr_payment_log, tr_petty_cash, tr_cashier_shift, mst_outlet)
# Gunakan user MySQL khusus dengan izin SELECT saja.
DB_HOST_MY_WASCHEN=
DB_PORT_MY_WASCHEN=
DB_USER_MY_WASCHEN=
DB_PASS_MY_WASCHEN=
DB_NAME_MY_WASCHEN=

# Penarikan otomatis data POS tiap malam (WIB). Hanya menarik & mencatat, tidak memposting jurnal.
# POS_SYNC_ENABLED=true
# POS_SYNC_HOUR=22
# POS_SYNC_MINUTE=5

# Folder assets SuperApp (server yang sama). Bukti bayar pengajuan ditulis ke <folder>/purchase/
# Dev: path backend-superapp/assets · Prod: sama dengan UPLOAD_BASE_DIR SuperApp
SUPERAPP_ASSETS_DIR=
